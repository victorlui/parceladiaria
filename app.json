{
  "expo": {
    "name": "Parcela Diaria",
    "slug": "parceladiaria",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "parceladiaria",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#053E38"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light",
      "infoPlist": {
        "UIUserInterfaceStyle": "Light",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "$(PRODUCT_NAME) precisa acessar sua camera",
        "NSPhotoLibraryUsageDescription": "$(PRODUCT_NAME) precisa acessar sua galeria para selecionar imagens e documentos.",
        "NSPhotoLibraryAddUsageDescription": "$(PRODUCT_NAME) pode salvar arquivos temporarios de imagem durante o envio.",
        "NSMicrophoneUsageDescription": "$(PRODUCT_NAME) precisa acessar o microfone.",
        "CFBundleDevelopmentRegion": "pt_BR",
        "AppStoreID": "6755193206",
        "AppStoreCountry": "br"
      },
      "bundleIdentifier": "br.com.parceladiaria",
      "icon": {
        "light": "./assets/icons/ios-icon/ios-icon-iOS-Default.png",
        "dark": "./assets/icons/ios-icon/ios-icon-iOS-Dark.png",
        "tinted": "./assets/icons/ios-icon/ios-icon-iOS-TintedDark.png"
      },
      "buildNumber": "72"
    },
    "android": {
      "versionCode": 73,
      "adaptiveIcon": {
        "backgroundColor": "#053E38"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "whatsapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "br.com.parceladiaria",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      "react-native-compressor",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#053E38"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para que você possa enviar.",
          "cameraPermission": "O app acessa sua câmera para que você possa tirar fotos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0f172a",
          "barStyle": "light",
          "borderColor": "#1f2937",
          "visibility": "visible",
          "behavior": "inset-swipe",
          "position": "relative"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos acessar sua câmera para validar sua selfie."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60539f4b-9218-4b0e-bc11-36087752f557"
      }
    },
    "runtimeVersion": "1.3.1",
    "updates": {
      "url": "https://u.expo.dev/60539f4b-9218-4b0e-bc11-36087752f557",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
